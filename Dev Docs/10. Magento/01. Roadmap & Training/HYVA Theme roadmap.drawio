        <mxCell id="8zMjYq8l6qe2jhDaCnuh-1782" value="&lt;p style=&quot;line-height: 200%; font-size: 14px;&quot;&gt;&lt;/p&gt;&lt;div style=&quot;text-align: justify; font-size: 14px;&quot;&gt;&lt;b style=&quot;font-size: 14px;&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;/span&gt;Chú ý:&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;ul style=&quot;line-height: 200%; font-size: 14px;&quot;&gt;&lt;li style=&quot;text-align: justify; font-size: 14px;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;Check roadmap từ trên xuống,&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;text-align: justify; font-size: 14px;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;Nên check theo hướng mũi tên điều hướng&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;text-align: justify; font-size: 14px;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;Roadmap này được tối ưu tập trung vào các phần nên tìm hiểu.&amp;nbsp;&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;text-align: justify; font-size: 14px;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;Các key word trong roadmap có thể xem trực tiếp ở:&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;a class=&quot;in-cell-link&quot; target=&quot;_blank&quot; href=&quot;https://alpinejs.dev/&quot; style=&quot;text-align: justify; background-color: initial; border-color: var(--border-color); font-size: 14px;&quot;&gt;&lt;/a&gt;&lt;ol style=&quot;line-height: 160%; font-size: 14px;&quot;&gt;&lt;li style=&quot;font-size: 14px;&quot;&gt;&lt;u style=&quot;font-size: 14px;&quot;&gt;&lt;font color=&quot;#0000ff&quot; style=&quot;font-size: 14px;&quot;&gt;https://alpinejs.dev/&amp;nbsp;&lt;/font&gt;&lt;/u&gt;&lt;/li&gt;&lt;li style=&quot;font-size: 14px;&quot;&gt;&lt;a style=&quot;background-color: initial; text-align: justify; border-color: var(--border-color); font-size: 14px;&quot; class=&quot